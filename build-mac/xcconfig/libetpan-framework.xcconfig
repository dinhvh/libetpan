ALWAYS_SEARCH_USER_PATHS = NO
COMBINE_HIDPI_IMAGES = YES
DYLIB_COMPATIBILITY_VERSION = 1
DYLIB_CURRENT_VERSION = 1
FRAMEWORK_VERSION = A
GCC_MODEL_TUNING = G5
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_JMAP=1 HAVE_COREFOUNDATION_CHARCONV=1 USE_SMIME_APPLE=1 USE_SMIME_OPENSSL=1 USE_PGP_RNP=1
INFOPLIST_FILE = Info.plist
INSTALL_PATH = @loader_path/../Frameworks
MACOSX_DEPLOYMENT_TARGET = 12.0
OTHER_LDFLAGS = -lz -liconv -lc++ -lxml2
PRODUCT_NAME = libetpan
SDKROOT = macosx
WRAPPER_EXTENSION = framework

COPY_PHASE_STRIP[config=Debug] = NO
GCC_DYNAMIC_NO_PIC[config=Debug] = NO
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0

DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym
STRIP_INSTALLED_PRODUCT[config=Release] = YES
