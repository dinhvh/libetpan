prefix=@prefix@
exec_prefix=@exec_prefix@
includedir=@includedir@
libdir=@libdir@

Name: libetpan
Description: Libetpan C library.
Version: @VERSION@
Requires.private: @ICU_PKGCONFIG@
Libs: -L${libdir} -letpan@LIBSUFFIX@ @SSLLIBS@ @GNUTLSLIB@ @LIBICONV@ @DBLIB@ @LIBS@ @SASLLIBS@
Libs.private: @ICULIB@
Cflags: -I${includedir}
